<?xml version="1.0" encoding="utf-8" standalone="no"?>
<Project>
    <PropertyGroup>
        <Company>Yextly Group</Company>
        <Copyright>Copyright © Yextly Group</Copyright>
        <!-- S125 SonarQube incorrectly detects the banner as code -->
        <!-- CA1515 .Net 9.0 incorrectly marks xunit tests as unreferenced. xUnit analyzers should suppress it, but it does not work for now -->
        <NoWarn>$(NoWarn);CA1014;CA1812;NU1507;S125;CA1515</NoWarn>

        <LangVersion>13</LangVersion>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <EnableNETAnalyzers>True</EnableNETAnalyzers>
        <AnalysisMode>All</AnalysisMode>

        <GenerateDocumentationFile>True</GenerateDocumentationFile>

        <WarnOnPackingNonPackableProject>True</WarnOnPackingNonPackableProject>

        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>Yextly Group; Contributors</Authors>
        <PackageProjectUrl>https://github.com/yextly/fx</PackageProjectUrl>
        <PackageReleaseNotes>See $(PackageProjectUrl)/blob/main/CHANGELOG.md#$(VersionSuffix.Replace('.','')) for release notes.</PackageReleaseNotes>

        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/yextly/fx.git</RepositoryUrl>
        <PackageReadmeFile>PackageReadme.md</PackageReadmeFile>

        <PackageIcon>Package.png</PackageIcon>
    </PropertyGroup>

    <Choose>
        <When Condition=" ('$(EnableGitInfo)' != 'false') ">
            <PropertyGroup>

                <!-- GitInfo configuration -->
                <GitTagRegex>v?*</GitTagRegex>
                <GitDefaultBranch>main</GitDefaultBranch>
                <GitIgnoreBranchVersion>true</GitIgnoreBranchVersion>
                <GitIgnoreTagVersion>false</GitIgnoreTagVersion>

                <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
                <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
                <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
                
                <!-- Allow code detection -->
                <DefineConstants>$(DefineConstants);ENABLE_GITINFO</DefineConstants>
            </PropertyGroup>

            <!-- Use DoNotWantGitInfoHere in case we are overincluding -->            
            <ItemGroup Condition=" ('DoNotWantGitInfoHere') != 'true' ">
                <PackageReference Include="GitInfo">
                    <PrivateAssets>all</PrivateAssets>
                    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
                </PackageReference>
            </ItemGroup>

            <ItemGroup Condition=" ('DoNotWantGitInfoHere') != 'true' ">
                <Compile Include="..\Shared\AssemblyInfo.cs" Link="AssemblyInfo.cs" />
            </ItemGroup>
            
        </When>

        <Otherwise>
            <PropertyGroup>

                <!-- Detect forced version -->
                <_EffectiveVersion Condition=" '$(Version)' != '' ">$(Version)</_EffectiveVersion>
                <_EffectiveVersion Condition=" '$(Version)' == '' ">3.14.15.92</_EffectiveVersion>

                <!-- Strip prerelease suffix (everything after '-') -->
                <_CleanVersion>$([System.String]::Copy('$(_EffectiveVersion)').Split('-')[0])</_CleanVersion>

                <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
                <GenerateAssemblyFileVersionAttribute>true</GenerateAssemblyFileVersionAttribute>
                <!--<GenerateAssemblyInformationalVersionAttribute>true</GenerateAssemblyInformationalVersionAttribute>

                --><!-- Informational keeps full version (including preview) --><!--
                <AssemblyInformationalVersion>$(_EffectiveVersion)</AssemblyInformationalVersion>-->

                <!-- Strict numeric versions -->
                <AssemblyVersion>$(_CleanVersion)</AssemblyVersion>
                <FileVersion>$(_CleanVersion)</FileVersion>

            </PropertyGroup>
        </Otherwise>
    </Choose>
    
    <ItemGroup>
        <None Include="$([System.IO.Path]::Combine($(MSBuildThisFileDirectory),&quot;Images&quot;,&quot;Package.png&quot;))">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>
    <ItemGroup>
        <None Include="$([System.IO.Path]::Combine($(MSBuildThisFileDirectory),&quot;Docs&quot;,&quot;PackageReadme.md&quot;))">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>
</Project>
